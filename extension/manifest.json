{
  "manifest_version": 3,
  "name": "Decepta AI - Web Scraper Node",
  "version": "1.3",
  "description": "Decepta AI e-ticaret bot tespiti için yerel DOM kazıyıcı eklenti.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.trendyol.com/*",
    "https://*.hepsiburada.com/*",
    "https://*.n11.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
